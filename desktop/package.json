{
  "name": "truckaudiosim",
  "version": "0.23.3",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win zip --x64"
  },
  "dependencies": {
    "koffi": "^3.3.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "description": "TruckAudioSim Windows Spatial Sound with the Trucker AUX desktop editor",
  "author": "SergeyDoes",
  "build": {
    "appId": "com.truckaudiosim.desktop",
    "productName": "TruckAudioSim",
    "directories": {
      "output": "out"
    },
    "files": [
      "src/**",
      "package.json",
      "presets/default/**",
      "!**/node_modules/@koromix/koffi-{linux,darwin,freebsd,openbsd,android}-*{,/**}",
      {
        "from": "node_modules/three/examples/jsm/controls",
        "to": "node_modules/three/examples/jsm/controls",
        "filter": [
          "OrbitControls.js"
        ]
      }
    ],
    "extraFiles": [
      {
        "from": "presets",
        "to": "presets",
        "filter": [
          "README.md"
        ]
      },
      {
        "from": "plugin",
        "to": "plugin"
      },
      {
        "from": "LICENSE-Trucker-AUX.txt",
        "to": "LICENSE-Trucker-AUX.txt"
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "artifactName": "${productName}-${version}-win-x64.${ext}"
    },
    "extraResources": [
      {
        "from": "../bin-x64/tas_spatial.exe",
        "to": "engine/tas_spatial.exe"
      },
      {
        "from": "../validacion-x64/prueba_7_1_canales_48k.wav",
        "to": "engine/prueba_7_1_canales_48k.wav"
      },
      {
        "from": "../bin-x64/tas_media_control.exe",
        "to": "engine/tas_media_control.exe"
      }
    ]
  }
}
