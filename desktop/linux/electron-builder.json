{
  "extends": null,
  "appId": "com.truckaudiosim.desktop",
  "productName": "TruckAudioSim",
  "files": [
    "src/**",
    "package.json",
    "presets/default/**",
    "!**/node_modules/@koromix/koffi-{win32,darwin,freebsd,openbsd,android}-*{,/**}",
    {
      "from": "node_modules/three/examples/jsm/controls",
      "to": "node_modules/three/examples/jsm/controls",
      "filter": ["OrbitControls.js"]
    }
  ],
  "extraFiles": [
    { "from": "plugin", "to": "plugin" },
    { "from": "LICENSE-Trucker-AUX.txt", "to": "LICENSE-Trucker-AUX.txt" }
  ],
  "linux": { "executableName": "truckaudiosim" }
}
